{
  "name": "@linbin-mk/dsh-session-sync",
  "description": "Git-backed session sync plugin for DeepSeek Harness: keeps sessions of mapped projects in sync across machines through one git repository, served to the web settings page through its own same-origin HTTP API",
  "version": "0.2.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "linbin-mk (https://github.com/linbin-mk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linbin-mk/dsh-session-sync.git",
    "directory": "packages/session-sync"
  },
  "homepage": "https://github.com/linbin-mk/dsh-session-sync#readme",
  "bugs": {
    "url": "https://github.com/linbin-mk/dsh-session-sync/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "session-sync",
    "session",
    "sync",
    "git",
    "cross-machine",
    "multi-machine",
    "typescript"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.tests.json",
    "test": "pnpm build && vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@deepseek-ai/dsh-agent": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-workspace": "^0.1.7-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/cordis-plugin-include": "^1.0.8",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-app-boot": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-config-editor": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-title": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-storage": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-storage-json": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-workspace": "^0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@linbin-mk/dsh-session-sync": "workspace:^",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
